{
  "expo": {
    "name": "Pdf Ocr Scan",
    "slug": "pdfocr-scan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wess.pdfocrscanpro",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan documents.",
        "GADApplicationIdentifier": "ca-app-pub-7561161015961675~9675736118"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.wess.pdfocrscanpro",
      "versionCode": 4,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7561161015961675~9675736118",
          "iosAppId": "ca-app-pub-7561161015961675~9675736118"
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "iOSNSCameraUsageDescription": "We need camera access to scan documents"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b0fa27eb-046d-4154-b635-10ff4276b92c"
      }
    }
  }
}